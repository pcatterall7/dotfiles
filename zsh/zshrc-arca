#!/bin/zsh

# ====== PATH ======
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# ====== EDITOR ======
export EDITOR="vim"

# ====== COLOR ======
export COLORTERM=truecolor

# ====== ALIASES ======
alias gs='git status'

# ====== FUNCTIONS ======
mkcd() { mkdir -p "$1" && cd "$1"; }

tempe() {
  cd "$(mktemp -d)"
  chmod -R 0700 .
  if [[ $# -eq 1 ]]; then
    mkdir -p "$1" && cd "$1"
    chmod -R 0700 .
  fi
}

# ====== FZF ======
export FZF_DEFAULT_OPTS='--height 40% --reverse'
command -v fzf &>/dev/null && source <(fzf --zsh)
